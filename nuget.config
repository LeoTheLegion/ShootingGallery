<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- GitHub Packages feed for CoreEssentials-MonoGame (LeoTheLegion). Auth via the
         GITHUB_PACKAGES_TOKEN env var — see <packageSourceCredentials> below and README.md. -->
    <add key="github-packages" value="https://nuget.pkg.github.com/leothelegion/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Auth for the GitHub Packages feed. Per GitHub's docs the credentials element must be named
       after the SOURCE KEY ("github-packages"), NOT the URL — a mismatched key silently sends no
       auth at all (401). The password comes from the GITHUB_PACKAGES_TOKEN environment variable
       (NuGet expands %VAR% via .NET's ExpandEnvironmentVariables) — no secret in this file.
       Set it once persistently:
         [Environment]::SetEnvironmentVariable("GITHUB_PACKAGES_TOKEN", "ghp_...", "User") -->
  <packageSourceCredentials>
    <github-packages>
      <add key="Username" value="LeoTheLegion" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-packages>
  </packageSourceCredentials>
</configuration>
