<?xml version="1.0" encoding="utf-8"?>
<!--
  Start menu, fully data-driven with CE's anchored GUI (CE 0.20.0 strict scene format).
  A root GameObjectEntity carries the CanvasComponent; each label/button is a child of
  AnchorComponent + Label/Button component. The START MUTATION button click is bound
  declaratively (<Bind> to MenuCommandsComponent.StartGame). The two decorative radiation
  popups are static entities referencing the Popup prefab, with per-instance overrides.
-->
<Scene>
  <GameSystems>
    <System Type="EntitySystem">
      <Prefabs>
        <Prefab Name="Popup" Asset="popup.xml" />
      </Prefabs>
      <Entities>
  <EntityDefinition Type="GameObjectEntity" Id="hud">
    <Position X="0" Y="0" />
    <Components>
      <Component Type="CanvasComponent" />
      <Component Type="AnchorComponent">
        <Properties>
          <Property Name="Preset" Value="TopLeft" />
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
      <!-- Command target for the <Bind>-wired button below (no FindById + subscribe code). -->
      <Component Type="MenuCommandsComponent" />
            <!-- Hides CE's debug sticky log (must run after LoadGUI, so it lives in a component). -->
            <Component Type="HideDebugLogComponent" />
      </Components>
    <Children>
      <EntityDefinition Type="GameObjectEntity" Id="title">
        <Components>
          <!-- Left anchor + HorizontalAlignment=Center: 0.19.0 centers the widget on the
               canvas; a TopCenter anchor would double-shift (viewport is the canvas rect). -->
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,100" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="URANIUM REVOLVER" />
              <Property Name="TextColor" Value="LimeGreen" />
              <Property Name="Scale" Value="2.5" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="subtitle">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,160" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="A Radioactive Shooting Gallery" />
              <Property Name="TextColor" Value="Yellow" />
              <Property Name="Scale" Value="1.5" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="line1">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,240" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Shoot targets to score points and accumulate radiation" />
              <Property Name="TextColor" Value="White" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="line2">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,290" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Mutations will give you extra arms to shoot with" />
              <Property Name="TextColor" Value="LightGreen" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="line3">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,340" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Avoid radioactive bombs or face instant death!" />
              <Property Name="TextColor" Value="Red" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="warning">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,390" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="WARNING: Extreme Radiation Exposure!" />
              <Property Name="TextColor" Value="Orange" />
              <Property Name="Scale" Value="1.2" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="startButton">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,490" />
            </Properties>
          </Component>
          <Component Type="ButtonComponent">
            <Properties>
              <Property Name="Text" Value="START MUTATION" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
          <Bind Event="Clicked" Command="StartGame" />
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="footer">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="BottomLeft" />
              <Property Name="Offset" Value="0,-80" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Created with Uranium Power - Warning: May Cause Mutations" />
              <Property Name="TextColor" Value="LightGreen" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>
    </Children>
  </EntityDefinition>

        <!-- Decorative radiation popups: static instances of the Popup prefab. Positions are
             fixed relative to World.Center (640,360) at +/-300 on X. Text is set via <Overrides>
             because both FloatingPopUpComponent and LabelComponent expose a "Text" property
             (a flat Text="..." override would be ambiguous). -->
        <EntityDefinition Source="Popup" Id="popupLeft">
          <Position X="340" Y="360" />
          <Overrides>
            <Component Type="FloatingPopUpComponent">
              <Property Name="Text" Value="☢️ RADIATION ☢️" />
              <Property Name="TextColor" Value="50,205,50,255" />
              <Property Name="Scale" Value="1.5" />
              <Property Name="Duration" Value="5" />
              <Property Name="RadiationEffect" Value="true" />
            </Component>
          </Overrides>
        </EntityDefinition>

        <EntityDefinition Source="Popup" Id="popupRight">
          <Position X="940" Y="360" />
          <Overrides>
            <Component Type="FloatingPopUpComponent">
              <Property Name="Text" Value="☢️ RADIATION ☢️" />
              <Property Name="TextColor" Value="50,205,50,255" />
              <Property Name="Scale" Value="1.5" />
              <Property Name="Duration" Value="5" />
              <Property Name="RadiationEffect" Value="true" />
            </Component>
          </Overrides>
        </EntityDefinition>
      </Entities>
    </System>
  </GameSystems>
</Scene>
