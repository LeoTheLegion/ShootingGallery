<!--
  Target template: a plain GameObjectEntity whose entire behavior is the TargetComponent.
  The sprite (asset + tint) is owned by the component at runtime; no SpriteComponent is
  declared here because template instantiation re-applies XML component properties after
  OnStart, which would clobber the component's sprite assignment.
-->
<Prefab Type="GameObjectEntity" Rotation="0" Sort="0" Active="true">
    <Tags>
        <Tag Name="Target" />
        <Tag Name="Regular" />
    </Tags>
    <Components>
        <Component Type="TargetComponent">
            <Properties>
                <Property Name="Type" Value="Standard" />
            </Properties>
        </Component>
    </Components>
</Prefab>
