<!--
  Target template: a plain GameObjectEntity whose entire behavior is the TargetComponent.
  The SpriteComponent (loads its own sprite from SpriteAsset) and TweenComponent are declared
  here so TargetComponent can grab them at attach time instead of adding components to the
  entity mid-enumeration (which CE's AttachPendingComponents does not allow).
-->
<Prefab Type="GameObjectEntity" Rotation="0" Sort="0" Active="true">
    <Tags>
        <Tag Name="Target" />
        <Tag Name="Regular" />
    </Tags>
    <Components>
        <Component Type="SpriteComponent">
            <Properties>
                <Property Name="SpriteAsset" Value="target_sprite.xml" />
                <Property Name="Origin" Value="0.5,0.5" />
            </Properties>
        </Component>
        <Component Type="TweenComponent" />
        <Component Type="TargetComponent">
            <Properties>
                <Property Name="Type" Value="Standard" />
            </Properties>
        </Component>
    </Components>
</Prefab>
