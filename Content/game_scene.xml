<?xml version="1.0" encoding="utf-8"?>
<!--
  Game HUD layout, fully data-driven with CE's anchored GUI (PR #70): a root
  GameObjectEntity carries the CanvasComponent; every label is a child composed of an
  AnchorComponent (preset + pixel offset) plus a LabelComponent. The crosshair, radiation
  manager and game manager are gameplay entities created in code (see GameScene). Each label
  carries an Id so code can grab its component to drive live updates (score, timer, etc.).
-->
<Scene>
  <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="hud">
    <Position X="0" Y="0" />
    <Components>
      <Component Type="CanvasComponent" />
      <Component Type="AnchorComponent">
        <Properties>
          <Property Name="Preset" Value="TopLeft" />
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
    </Components>

    <Children>
      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="title">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopCenter" />
              <Property Name="Offset" Value="0,30" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="URANIUM REVOLVER" />
              <Property Name="TextColor" Value="LimeGreen" />
              <Property Name="Scale" Value="1.5,1.5" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="score">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,20" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Score: 0" />
              <Property Name="TextColor" Value="White" />
              <Property Name="Scale" Value="1.2,1.2" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="timer">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopRight" />
              <Property Name="Offset" Value="-150,20" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Time: 300" />
              <Property Name="TextColor" Value="Yellow" />
              <Property Name="Scale" Value="1.2,1.2" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="multiplier">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,50" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Multiplier: x10.0" />
              <Property Name="TextColor" Value="Orange" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="radiation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopRight" />
              <Property Name="Offset" Value="-150,50" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Radiation: 0%" />
              <Property Name="TextColor" Value="LimeGreen" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="mutation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,80" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Arms: 1" />
              <Property Name="TextColor" Value="LimeGreen" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>
    </Children>
  </EntityDefinition>
</Scene>
