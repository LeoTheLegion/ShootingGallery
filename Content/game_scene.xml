<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully data-driven game scene: a root GameObjectEntity carries the CanvasComponent; every
  label is a child composed of an AnchorComponent (preset + pixel offset) plus a LabelComponent.
  The crosshair and round director are also declared here as plain GameObjectEntities whose
  entire behavior lives in components (CrosshairComponent / GameDirectorComponent). Each label
  carries an Id so the director can resolve it by id on its first Update.
-->
<Scene>
  <EntityDefinition Type="GameObjectEntity" Id="hud">
    <Position X="0" Y="0" />
    <Components>
      <Component Type="CanvasComponent" />
      <Component Type="AnchorComponent">
        <Properties>
          <Property Name="Preset" Value="TopLeft" />
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
    </Components>

    <Children>
      <EntityDefinition Type="GameObjectEntity" Id="title">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopCenter" />
              <Property Name="Offset" Value="0,30" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="URANIUM REVOLVER" />
              <Property Name="TextColor" Value="LimeGreen" />
              <Property Name="Scale" Value="1.5,1.5" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="score">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,20" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Score: 0" />
              <Property Name="TextColor" Value="White" />
              <Property Name="Scale" Value="1.2,1.2" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="timer">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopRight" />
              <Property Name="Offset" Value="-150,20" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Time: 300" />
              <Property Name="TextColor" Value="Yellow" />
              <Property Name="Scale" Value="1.2,1.2" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="multiplier">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,50" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Multiplier: x10.0" />
              <Property Name="TextColor" Value="Orange" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="radiation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopRight" />
              <Property Name="Offset" Value="-150,50" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Radiation: 0%" />
              <Property Name="TextColor" Value="LimeGreen" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="mutation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,80" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Arms: 1" />
              <Property Name="TextColor" Value="LimeGreen" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>
    </Children>
  </EntityDefinition>

  <!-- Player crosshair: a plain GameObjectEntity whose behavior is entirely components.
       The main sprite is owned by CrosshairComponent (scene XML can't assign a Sprite
       object); MouseFollow/MouseClick are declared before it so they exist at OnAttach. -->
  <EntityDefinition Type="GameObjectEntity" Id="crosshair">
    <Tags>
      <Tag Name="Crosshair" />
    </Tags>
    <Components>
      <Component Type="MouseFollowComponent">
        <Properties>
          <Property Name="Offset" Value="25,25" />
        </Properties>
      </Component>
      <Component Type="MouseClickComponent" />
      <Component Type="CrosshairComponent" />
    </Components>
  </EntityDefinition>

  <!-- Round director: a hidden GameObjectEntity (no sprite) whose GameDirectorComponent owns
       the timer, score, multiplier, target grid, spawning, radiation/mutation and game-over. -->
  <EntityDefinition Type="GameObjectEntity" Id="director">
    <Components>
      <Component Type="GameDirectorComponent" />
    </Components>
  </EntityDefinition>
</Scene>
