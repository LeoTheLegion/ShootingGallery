<?xml version="1.0" encoding="utf-8"?>
<!--
    Scene manifest for Shooting Gallery (CE 0.20.0 scene-as-data).

    - <GameScenes> lists every scene the game can load, in order. The FIRST entry is the startup scene.
    - A scene's LoadingScreen attribute names the loading screen used when transitioning INTO that scene;
      if absent, the default loading screen is used.
    - <LoadingScenes> lists the loading screens; exactly one may be marked Default="true".

    Loaded and enforced by the core: SceneManager.SetManifestAsset("Scenes/scenes.xml") must be called
    before any name-based LoadScene/SetLoadingScene call, and every name-based load must reference an
    entry here. Scene names are content-relative paths (forward slashes).
-->
<Scenes>
    <GameScenes>
        <Scene Name="Scenes/start_menu.xml" />
        <Scene Name="Scenes/game_scene.xml" />
        <Scene Name="Scenes/game_over.xml" />
    </GameScenes>
    <LoadingScenes>
        <LoadingScene Name="Scenes/loading.xml" Default="true" />
    </LoadingScenes>
</Scenes>
