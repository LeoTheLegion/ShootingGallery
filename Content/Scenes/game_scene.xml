<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully data-driven game scene (CE 0.20.0 strict scene format): a root GameObjectEntity carries
  the CanvasComponent; every label is a child composed of an AnchorComponent (preset + pixel
  offset) plus a LabelComponent. The crosshair and round director are also declared here as plain
  GameObjectEntities whose entire behavior lives in components (CrosshairComponent /
  GameDirectorComponent). Each label carries an Id so the director can resolve it by id on its
  first Update.
-->
<Scene>
  <GameSystems>
    <System Type="EntitySystem">
      <Prefabs>
        <!-- Score/radiation popups are instantiated at runtime by the director and targets. -->
        <Prefab Name="Popup" Asset="Prefabs/popup.xml" />
        <!-- Transient hit/detonation effects, spawned by TargetComponent on impact. -->
        <Prefab Name="HitEffect" Asset="Prefabs/hit_effect.xml" />
        <Prefab Name="BombEffect" Asset="Prefabs/bomb_effect.xml" />
      </Prefabs>
      <Entities>
  <EntityDefinition Type="GameObjectEntity" Id="hud">
    <Position X="0" Y="0" />
    <Components>
      <Component Type="CanvasComponent" />
      <Component Type="AnchorComponent">
        <Properties>
          <Property Name="Preset" Value="TopLeft" />
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
    </Components>

    <Children>
      <EntityDefinition Type="GameObjectEntity" Id="title">
        <Components>
          <!-- Left anchor + HorizontalAlignment=Center: 0.19.0 centers the widget on the
               canvas; a TopCenter anchor would double-shift (viewport is the canvas rect). -->
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,30" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="URANIUM REVOLVER" />
              <Property Name="TextColor" Value="LimeGreen" />
              <Property Name="Scale" Value="1.5,1.5" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="score">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,20" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Score: 0" />
              <Property Name="TextColor" Value="White" />
              <Property Name="Scale" Value="1.2,1.2" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="timer">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopRight" />
              <Property Name="Offset" Value="-150,20" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Time: 300" />
              <Property Name="TextColor" Value="Yellow" />
              <Property Name="Scale" Value="1.2,1.2" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="multiplier">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,50" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Multiplier: x10.0" />
              <Property Name="TextColor" Value="Orange" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="radiation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopRight" />
              <Property Name="Offset" Value="-150,50" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Radiation: 0%" />
              <Property Name="TextColor" Value="LimeGreen" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="mutation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="20,80" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Arms: 1" />
              <Property Name="TextColor" Value="LimeGreen" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>
    </Children>
  </EntityDefinition>

  <!-- Player crosshair: a plain GameObjectEntity whose behavior is entirely components.
       The main sprite is declared on a SpriteComponent (CE 0.20.0 loads it from the SpriteAsset
       property); CrosshairComponent only registers it for instanced rendering + sets the z-layer.
       MouseFollow/MouseClick are declared before CrosshairComponent so they exist at OnAttach. -->
  <EntityDefinition Type="GameObjectEntity" Id="crosshair">
    <Tags>
      <Tag Name="Crosshair" />
    </Tags>
    <Components>
      <!-- Declared first so its OnAttach has loaded the sprite before CrosshairComponent attaches.
           Centered origin (0.5,0.5) matches the previous hand-drawn crosshair. -->
      <Component Type="SpriteComponent">
        <Properties>
          <Property Name="SpriteAsset" Value="Sprites/crosshair_sprite.xml" />
          <Property Name="Origin" Value="0.5,0.5" />
        </Properties>
      </Component>
      <!-- Offset is 0: the sprite data (crosshair_sprite.xml) already declares a centered
           origin, and CE places the sprite's origin at the entity Position. -->
      <Component Type="MouseFollowComponent">
        <Properties>
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
      <Component Type="MouseClickComponent" />
      <Component Type="CrosshairComponent" />
    </Components>
  </EntityDefinition>

  <!-- Balance configuration: a hidden GameObjectEntity (no sprite) whose GameConfigComponent is
       pure data. Every value is declared explicitly here so there's no hidden static load; the
       director and spawned targets resolve it by tag "GameConfig". -->
  <EntityDefinition Type="GameObjectEntity" Id="config">
    <Tags>
      <Tag Name="GameConfig" />
    </Tags>
    <Components>
      <Component Type="GameConfigComponent">
        <Properties>
          <!-- Game timing -->
          <Property Name="RoundTime" Value="60.0" />
          <Property Name="TimeMultiplierStart" Value="10.0" />
          <Property Name="TimeMultiplierMin" Value="1.0" />
          <Property Name="TimeMultiplierDecay" Value="0.3" />
          <!-- Target spawning -->
          <Property Name="TargetSpawnDelay" Value="0.25" />
          <Property Name="TargetSpawnRandomFactor" Value="0.2" />
          <!-- Target growth -->
          <Property Name="TargetDefaultScale" Value="0.3" />
          <Property Name="TimeToFullSize" Value="0.75" />
          <!-- Target type chances -->
          <Property Name="BombChance" Value="0.2" />
          <Property Name="RadioactiveChance" Value="0.15" />
          <!-- Bomb fade -->
          <Property Name="BombFadeStartTime" Value="5.0" />
          <Property Name="BombFadeDuration" Value="3.0" />
          <!-- Target size / grid -->
          <Property Name="TargetRadius" Value="45" />
          <Property Name="GridRows" Value="5" />
          <Property Name="GridCols" Value="5" />
          <!-- Scoring -->
          <Property Name="ScoreRegularSmall" Value="5" />
          <Property Name="ScoreRegularMedium" Value="10" />
          <Property Name="ScoreRegularLarge" Value="15" />
          <Property Name="ScoreRadioactiveSmall" Value="10" />
          <Property Name="ScoreRadioactiveMedium" Value="20" />
          <Property Name="ScoreRadioactiveLarge" Value="30" />
          <!-- Radiation -->
          <Property Name="RadiationRegular" Value="1.0" />
          <Property Name="RadiationRadioactive" Value="3.0" />
          <!-- Growth thresholds -->
          <Property Name="TargetGrowthMedium" Value="0.6" />
          <Property Name="TargetGrowthLarge" Value="1.0" />
          <!-- Spawn acceleration (time remaining) -->
          <Property Name="SpawnAccelThreshold1" Value="45.0" />
          <Property Name="SpawnAccelThreshold2" Value="30.0" />
          <Property Name="SpawnAccelThreshold3" Value="15.0" />
          <Property Name="SpawnAccelMultiplier1" Value="0.6" />
          <Property Name="SpawnAccelMultiplier2" Value="0.5" />
          <Property Name="SpawnAccelMultiplier3" Value="0.4" />
        </Properties>
      </Component>
    </Components>
  </EntityDefinition>

  <!-- Round director: a hidden GameObjectEntity (no sprite) whose GameDirectorComponent owns
       the timer, score, multiplier, target grid, spawning, radiation/mutation and game-over.
       The target templates are serialized references (Unity [SerializeField] style),
       assigned here like prefab slots in the inspector. -->
  <EntityDefinition Type="GameObjectEntity" Id="director">
    <Components>
      <Component Type="GameDirectorComponent">
        <Properties>
          <!-- World size (design dimensions, not the window). Declared explicitly so there's no
               hidden fallback; change these to make the stage a different size than the screen. -->
          <Property Name="WorldWidth" Value="1280" />
          <Property Name="WorldHeight" Value="720" />
          <Property Name="RegularTargetTemplate" Value="Prefabs/target_regular.xml" />
          <Property Name="RadioactiveTargetTemplate" Value="Prefabs/target_radioactive.xml" />
          <Property Name="BombTargetTemplate" Value="Prefabs/target_bomb.xml" />
        </Properties>
      </Component>
    </Components>
  </EntityDefinition>
      </Entities>
    </System>
  </GameSystems>
</Scene>
