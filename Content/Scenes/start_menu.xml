<?xml version="1.0" encoding="utf-8"?>
<!--
  Start menu, fully data-driven with CE's anchored GUI (CE 0.20.0 strict scene format).
  A root GameObjectEntity carries the CanvasComponent; each label/button is a child of
  AnchorComponent + Label/Button component. The START MUTATION button click is bound
  declaratively (<Bind> to MenuCommandsComponent.StartGame). The two decorative radiation
  popups are static entities referencing the Popup prefab, with per-instance overrides.
-->
<Scene>
  <GameSystems>
    <System Type="EntitySystem">
      <Prefabs>
        <Prefab Name="Popup" Asset="Prefabs/popup.xml" />
      </Prefabs>
      <Entities>
  <!-- Full-screen backdrop: a plain SpriteComponent (no instanced-registration) so the entity
       system routes it to the back-most pass, behind the GUI text and every z-layered sprite. -->
  <EntityDefinition Type="GameObjectEntity" Id="background">
    <Position X="640" Y="360" />
    <Components>
      <Component Type="SpriteComponent">
        <Properties>
          <Property Name="SpriteAsset" Value="Sprites/background_sprite.xml" />
          <Property Name="Origin" Value="0.5,0.5" />
        </Properties>
      </Component>
    </Components>
  </EntityDefinition>

  <!-- START MUTATION back-plate: Kenney button sprite pinned to z-layer 1 (above background,
       below the GUI text pass), centered on the button (HorizontalAlignment=Center ⇒ x=640). -->
  <EntityDefinition Type="GameObjectEntity" Id="startButtonPlate">
    <!-- Centered on the button text: anchor top (490) + ~12px half line-height. -->
    <Position X="640" Y="502" />
    <Components>
      <Component Type="SpriteComponent">
        <Properties>
          <Property Name="SpriteAsset" Value="Sprites/ui_button_sprite.xml" />
          <Property Name="Origin" Value="0.5,0.5" />
        </Properties>
      </Component>
      <Component Type="UiPlateComponent">
        <Properties>
          <!-- Dark cool-slate tint: multiplies the light Kenney plate down so CE's white button text pops. -->
          <Property Name="Tint" Value="58,68,86" />
          <Property Name="Scale" Value="1.3" />
        </Properties>
      </Component>
    </Components>
  </EntityDefinition>

  <EntityDefinition Type="GameObjectEntity" Id="hud">
    <Position X="0" Y="0" />
    <Components>
      <Component Type="CanvasComponent" />
      <Component Type="AnchorComponent">
        <Properties>
          <Property Name="Preset" Value="TopLeft" />
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
      <!-- Command target for the <Bind>-wired button below (no FindById + subscribe code). -->
      <Component Type="MenuCommandsComponent" />
            <!-- Hides CE's debug sticky log (must run after LoadGUI, so it lives in a component). -->
            <Component Type="HideDebugLogComponent" />
      </Components>
    <Children>
      <EntityDefinition Type="GameObjectEntity" Id="title">
        <Components>
          <!-- Left anchor + HorizontalAlignment=Center: 0.19.0 centers the widget on the
               canvas; a TopCenter anchor would double-shift (viewport is the canvas rect). -->
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,100" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="URANIUM REVOLVER" />
              <!-- Primary accent (muted radioactive green) — the single hero color on this screen. -->
              <Property Name="TextColor" Value="176,204,120" />
              <Property Name="Scale" Value="2.5" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="subtitle">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,160" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="A Radioactive Shooting Gallery" />
              <!-- Secondary (cool grey-blue) — de-emphasized under the hero title. -->
              <Property Name="TextColor" Value="158,173,190" />
              <Property Name="Scale" Value="1.5" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="line1">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,240" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Shoot targets to score points and accumulate radiation" />
              <!-- Neutral body text (soft off-white, not pure white — easier on the eyes). -->
              <Property Name="TextColor" Value="206,214,222" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="line2">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,290" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Mutations will give you extra arms to shoot with" />
              <!-- Neutral body text. -->
              <Property Name="TextColor" Value="206,214,222" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="line3">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,340" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Avoid radioactive bombs or face instant death!" />
              <!-- Neutral body text — the alarm is carried by the WARNING line below. -->
              <Property Name="TextColor" Value="206,214,222" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="warning">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,390" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="WARNING: Extreme Radiation Exposure!" />
              <!-- Danger (muted terracotta red) — the single alarm accent on this screen. -->
              <Property Name="TextColor" Value="214,106,92" />
              <Property Name="Scale" Value="1.2" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="startButton">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,490" />
            </Properties>
          </Component>
          <Component Type="ButtonComponent">
            <Properties>
              <Property Name="Text" Value="START MUTATION" />
              <!-- Fully transparent background (alpha 0): draws nothing so the Kenney back-plate behind
                   shows through, but keeps a non-null brush so Myra still hit-tests the button. -->
              <Property Name="BackgroundTint" Value="0,0,0,0" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
          <Bind Event="Clicked" Command="StartGame" />
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="footer">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="BottomLeft" />
              <Property Name="Offset" Value="0,-80" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Created with Uranium Power - Warning: May Cause Mutations" />
              <!-- Muted grey + reduced opacity — least important, recedes to the background. -->
              <Property Name="TextColor" Value="120,132,144" />
              <Property Name="Opacity" Value="0.8" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>
    </Children>
  </EntityDefinition>

        <!-- Decorative radiation popups: static instances of the Popup prefab. Positions are
             fixed relative to the window center (640,360) at +/-300 on X. Text is set via <Overrides>
             because both FloatingPopUpComponent and LabelComponent expose a "Text" property
             (a flat Text="..." override would be ambiguous). -->
        <EntityDefinition Source="Popup" Id="popupLeft">
          <Position X="340" Y="360" />
          <Overrides>
            <Component Type="FloatingPopUpComponent">
              <Property Name="Text" Value="☢️ RADIATION ☢️" />
              <!-- Primary accent (muted radioactive green). -->
              <Property Name="TextColor" Value="176,204,120,255" />
              <Property Name="Scale" Value="1.5" />
              <Property Name="Duration" Value="5" />
              <Property Name="RadiationEffect" Value="true" />
            </Component>
          </Overrides>
        </EntityDefinition>

        <EntityDefinition Source="Popup" Id="popupRight">
          <Position X="940" Y="360" />
          <Overrides>
            <Component Type="FloatingPopUpComponent">
              <Property Name="Text" Value="☢️ RADIATION ☢️" />
              <!-- Primary accent (muted radioactive green). -->
              <Property Name="TextColor" Value="176,204,120,255" />
              <Property Name="Scale" Value="1.5" />
              <Property Name="Duration" Value="5" />
              <Property Name="RadiationEffect" Value="true" />
            </Component>
          </Overrides>
        </EntityDefinition>
      </Entities>
    </System>
  </GameSystems>
</Scene>
