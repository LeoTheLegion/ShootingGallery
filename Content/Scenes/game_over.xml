<?xml version="1.0" encoding="utf-8"?>
<!--
  Game over screen, fully data-driven with CE's anchored GUI (CE 0.20.0 strict scene format).
  A root GameObjectEntity carries the CanvasComponent; each label/button is a child of
  AnchorComponent + Label/Button component. The cause / score / mutation labels carry
  placeholder text here; GameOverScene overrides them at runtime. Button clicks are bound
  declaratively (<Bind> to MenuCommandsComponent).
-->
<Scene>
  <GameSystems>
    <System Type="EntitySystem">
      <Entities>
  <!-- Full-screen backdrop: plain SpriteComponent → back-most pass, behind GUI text. -->
  <EntityDefinition Type="GameObjectEntity" Id="background">
    <Position X="640" Y="360" />
    <Components>
      <Component Type="SpriteComponent">
        <Properties>
          <Property Name="SpriteAsset" Value="Sprites/background_sprite.xml" />
          <Property Name="Origin" Value="0.5,0.5" />
        </Properties>
      </Component>
    </Components>
  </EntityDefinition>

  <!-- Play Again back-plate: Kenney button sprite at z-layer 1, centered on the button (x=640). -->
  <EntityDefinition Type="GameObjectEntity" Id="restartButtonPlate">
    <!-- Centered on the button text: anchor top (460) + ~12px half line-height. -->
    <Position X="640" Y="472" />
    <Components>
      <Component Type="SpriteComponent">
        <Properties>
          <Property Name="SpriteAsset" Value="Sprites/ui_button_sprite.xml" />
          <Property Name="Origin" Value="0.5,0.5" />
        </Properties>
      </Component>
      <Component Type="UiPlateComponent">
        <Properties>
          <!-- Dark cool-slate tint: multiplies the light Kenney plate down so CE's white button text pops. -->
          <Property Name="Tint" Value="58,68,86" />
          <Property Name="Scale" Value="1.3" />
        </Properties>
      </Component>
    </Components>
  </EntityDefinition>

  <!-- Main Menu back-plate: Kenney button sprite at z-layer 1, centered on the button (x=640). -->
  <EntityDefinition Type="GameObjectEntity" Id="menuButtonPlate">
    <!-- Centered on the button text: anchor top (530) + ~12px half line-height. -->
    <Position X="640" Y="542" />
    <Components>
      <Component Type="SpriteComponent">
        <Properties>
          <Property Name="SpriteAsset" Value="Sprites/ui_button_sprite.xml" />
          <Property Name="Origin" Value="0.5,0.5" />
        </Properties>
      </Component>
      <Component Type="UiPlateComponent">
        <Properties>
          <!-- Dark cool-slate tint: multiplies the light Kenney plate down so CE's white button text pops. -->
          <Property Name="Tint" Value="58,68,86" />
          <Property Name="Scale" Value="1.3" />
        </Properties>
      </Component>
    </Components>
  </EntityDefinition>

  <EntityDefinition Type="GameObjectEntity" Id="hud">
    <Position X="0" Y="0" />
    <Components>
      <Component Type="CanvasComponent" />
      <Component Type="AnchorComponent">
        <Properties>
          <Property Name="Preset" Value="TopLeft" />
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
      <!-- Command target for the <Bind>-wired buttons below (no FindById + subscribe code). -->
      <Component Type="MenuCommandsComponent" />
      <!-- Reads GameDirectorComponent's static handoff and pokes cause/score/mutation labels. -->
      <Component Type="GameOverSummaryComponent" />
    </Components>

    <Children>
      <EntityDefinition Type="GameObjectEntity" Id="gameOver">
        <Components>
          <!-- Left anchor + HorizontalAlignment=Center: 0.19.0 centers the widget on the
               canvas; a TopCenter anchor would double-shift (viewport is the canvas rect). -->
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,100" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="GAME OVER" />
              <!-- Danger (muted terracotta red) — the alarm on this screen. -->
              <Property Name="TextColor" Value="214,106,92" />
              <Property Name="Scale" Value="2" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="cause">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,200" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Your 1 minute of shooting is up!" />
              <!-- Neutral body text. -->
              <Property Name="TextColor" Value="206,214,222" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="score">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,280" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Final Score: 0" />
              <!-- Secondary accent (muted amber) — reward. -->
              <Property Name="TextColor" Value="224,183,92" />
              <Property Name="Scale" Value="1.5" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="mutation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,360" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="You escaped without mutations!" />
              <!-- Primary accent (muted radioactive green) — mechanic recap. -->
              <Property Name="TextColor" Value="176,204,120" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="restartButton">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,460" />
            </Properties>
          </Component>
          <Component Type="ButtonComponent">
            <Properties>
              <Property Name="Text" Value="Play Again" />
              <!-- Fully transparent background (alpha 0): draws nothing so the Kenney back-plate behind
                   shows through, but keeps a non-null brush so Myra still hit-tests the button. -->
              <Property Name="BackgroundTint" Value="0,0,0,0" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
          <Bind Event="Clicked" Command="StartGame" />
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="menuButton">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,530" />
            </Properties>
          </Component>
          <Component Type="ButtonComponent">
            <Properties>
              <Property Name="Text" Value="Main Menu" />
              <!-- Fully transparent background (alpha 0): draws nothing so the Kenney back-plate behind
                   shows through, but keeps a non-null brush so Myra still hit-tests the button. -->
              <Property Name="BackgroundTint" Value="0,0,0,0" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
          <Bind Event="Clicked" Command="BackToMenu" />
        </Components>
      </EntityDefinition>
    </Children>
  </EntityDefinition>
      </Entities>
    </System>
  </GameSystems></Scene>