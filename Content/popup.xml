<!--
  Popup template: a plain GameObjectEntity for drifting, fading score popups.
  Component order matters — the screen-space CanvasComponent attaches first (CE 0.20.0 added
  a parameterless constructor, so it can be declared in XML directly), then LabelComponent
  resolves that canvas on attach. FloatingPopUpComponent just drives the label with per-popup
  values; it no longer creates the canvas in code.

  Unity-style prefab defaults: the values below are the baseline for every popup.
  Template properties are applied after OnAttach and before the first Update, so the
  component's deferred init (EnsureInitialized) always sees them. Each spawn site
  instantiates the template and pokes only what varies per spawn — mostly the text.
-->
<Prefab Type="GameObjectEntity" Rotation="0" Sort="10" Active="true">
    <Tags>
        <Tag Name="Popup" />
    </Tags>
    <Components>
        <!-- Screen-space canvas (parameterless ctor defaults to screen-space). Declared first so
             LabelComponent.RequireCanvas finds it on the same entity when it attaches. -->
        <Component Type="CanvasComponent" />
        <Component Type="FloatingPopUpComponent">
            <Properties>
                <!-- Prefab defaults (overridden per-instance by PopupSpawner) -->
                <Property Name="Text" Value="?" />
                <Property Name="TextColor" Value="255,255,255,255" />
                <Property Name="Scale" Value="1.0" />
                <Property Name="Duration" Value="2" />
                <Property Name="RadiationEffect" Value="false" />
            </Properties>
        </Component>
        <Component Type="LabelComponent" />
        <Component Type="TweenComponent" />
    </Components>
</Prefab>
