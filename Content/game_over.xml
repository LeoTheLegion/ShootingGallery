<?xml version="1.0" encoding="utf-8"?>
<!--
  Game over screen, fully data-driven with CE's anchored GUI: a root GameObjectEntity carries
  the CanvasComponent; each label/button is a child of AnchorComponent + Label/Button component.
  The cause / score / mutation labels carry placeholder text here; GameOverScene overrides them
  at runtime. Button clicks are wired in code by Id (restartButton / menuButton).
-->
<Scene>
  <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="hud">
    <Position X="0" Y="0" />
    <Components>
      <Component Type="CanvasComponent" />
      <Component Type="AnchorComponent">
        <Properties>
          <Property Name="Preset" Value="TopLeft" />
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
    </Components>

    <Children>
      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="gameOver">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopCenter" />
              <Property Name="Offset" Value="0,100" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="GAME OVER" />
              <Property Name="TextColor" Value="Red" />
              <Property Name="Scale" Value="2,2" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="cause">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopCenter" />
              <Property Name="Offset" Value="0,200" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Your 1 minute of shooting is up!" />
              <Property Name="TextColor" Value="White" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="score">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopCenter" />
              <Property Name="Offset" Value="0,280" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Final Score: 0" />
              <Property Name="TextColor" Value="Yellow" />
              <Property Name="Scale" Value="1.5,1.5" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="mutation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopCenter" />
              <Property Name="Offset" Value="0,360" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="You escaped without mutations!" />
              <Property Name="TextColor" Value="White" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="restartButton">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopCenter" />
              <Property Name="Offset" Value="0,460" />
            </Properties>
          </Component>
          <Component Type="ButtonComponent">
            <Properties>
              <Property Name="Text" Value="Play Again" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="CoreEssentials.GameSystems.EntitySystems.EntityOOPSystem.GameObjectEntity" Id="menuButton">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopCenter" />
              <Property Name="Offset" Value="0,530" />
            </Properties>
          </Component>
          <Component Type="ButtonComponent">
            <Properties>
              <Property Name="Text" Value="Main Menu" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>
    </Children>
  </EntityDefinition>
</Scene>
