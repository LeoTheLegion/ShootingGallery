<?xml version="1.0" encoding="utf-8"?>
<!--
  Game over screen, fully data-driven with CE's anchored GUI: a root GameObjectEntity carries
  the CanvasComponent; each label/button is a child of AnchorComponent + Label/Button component.
  The cause / score / mutation labels carry placeholder text here; GameOverScene overrides them
  at runtime. Button clicks are bound declaratively (<Bind> to MenuCommandsComponent).
-->
<Scene>
  <EntityDefinition Type="GameObjectEntity" Id="hud">
    <Position X="0" Y="0" />
    <Components>
      <Component Type="CanvasComponent" />
      <Component Type="AnchorComponent">
        <Properties>
          <Property Name="Preset" Value="TopLeft" />
          <Property Name="Offset" Value="0,0" />
        </Properties>
      </Component>
      <!-- Command target for the <Bind>-wired buttons below (no FindById + subscribe code). -->
      <Component Type="MenuCommandsComponent" />
    </Components>

    <Children>
      <EntityDefinition Type="GameObjectEntity" Id="gameOver">
        <Components>
          <!-- Left anchor + HorizontalAlignment=Center: 0.19.0 centers the widget on the
               canvas; a TopCenter anchor would double-shift (viewport is the canvas rect). -->
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,100" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="GAME OVER" />
              <Property Name="TextColor" Value="Red" />
              <Property Name="Scale" Value="2" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="cause">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,200" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Your 1 minute of shooting is up!" />
              <Property Name="TextColor" Value="White" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="score">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,280" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="Final Score: 0" />
              <Property Name="TextColor" Value="Yellow" />
              <Property Name="Scale" Value="1.5" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="mutation">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,360" />
            </Properties>
          </Component>
          <Component Type="LabelComponent">
            <Properties>
              <Property Name="Text" Value="You escaped without mutations!" />
              <Property Name="TextColor" Value="White" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="restartButton">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,460" />
            </Properties>
          </Component>
          <Component Type="ButtonComponent">
            <Properties>
              <Property Name="Text" Value="Play Again" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
          <Bind Event="Clicked" Command="StartGame" />
        </Components>
      </EntityDefinition>

      <EntityDefinition Type="GameObjectEntity" Id="menuButton">
        <Components>
          <Component Type="AnchorComponent">
            <Properties>
              <Property Name="Preset" Value="TopLeft" />
              <Property Name="Offset" Value="0,530" />
            </Properties>
          </Component>
          <Component Type="ButtonComponent">
            <Properties>
              <Property Name="Text" Value="Main Menu" />
              <Property Name="HorizontalAlignment" Value="Center" />
            </Properties>
          </Component>
          <Bind Event="Clicked" Command="BackToMenu" />
        </Components>
      </EntityDefinition>
    </Children>
  </EntityDefinition>
</Scene>
