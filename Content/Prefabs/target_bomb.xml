<!-- Target template: plain GameObjectEntity + Sprite/Tween/Target components (Bomb behavior). -->
<Prefab Type="GameObjectEntity" Rotation="0" Sort="0" Active="true">
    <Tags>
        <Tag Name="Target" />
        <Tag Name="Bomb" />
    </Tags>
    <Components>
        <Component Type="SpriteComponent">
            <Properties>
                <!-- Red bullseye + white skull baked in; TargetComponent uses a white tint so the
                     pixels read true and the warning pulse fades via alpha. -->
                <Property Name="SpriteAsset" Value="Sprites/target_bomb_sprite.xml" />
                <Property Name="Origin" Value="0.5,0.5" />
            </Properties>
        </Component>
        <Component Type="TweenComponent" />
        <Component Type="TargetComponent">
            <Properties>
                <Property Name="Type" Value="Bomb" />
            </Properties>
        </Component>
    </Components>
</Prefab>
