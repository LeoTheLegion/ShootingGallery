<!-- Bomb-detonation template: plain GameObjectEntity + Sprite/Effect components. Spawned at the bomb's
     position when it is hit; EffectComponent drives the big fireball scale-up + fade, then destroys. -->
<Prefab Type="GameObjectEntity" Rotation="0" Sort="21" Active="true">
    <Tags>
        <Tag Name="Effect" />
    </Tags>
    <Components>
        <Component Type="SpriteComponent">
            <Properties>
                <Property Name="SpriteAsset" Value="Sprites/explosion_fireball_sprite.xml" />
                <Property Name="Origin" Value="0.5,0.5" />
            </Properties>
        </Component>
        <Component Type="EffectComponent">
            <Properties>
                <!-- Prefab defaults (the spawn site does not override these). The bomb fireball
                     is the big payoff: a radial fireball that grows 90 -> 360px over a longer burn. -->
                <Property Name="StartScale" Value="1.5" />
                <Property Name="EndScale" Value="4.0" />
                <Property Name="Tint" Value="255,180,80,255" />
                <Property Name="Duration" Value="0.8" />
            </Properties>
        </Component>
    </Components>
</Prefab>
